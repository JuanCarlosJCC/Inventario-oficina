# Estas tres variables se configuran en Vercel (Settings -> Environment Variables).
# NUNCA se escriben en el código ni se suben a GitHub.

# Token personal de Airtable NUEVO, con permisos mínimos (ver SEGURIDAD.md)
AIRTABLE_PAT=

# Id de la base (empieza con "app")
AIRTABLE_BASE_ID=

# Texto largo y aleatorio (mínimo 32 caracteres) que firma las sesiones.
# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
